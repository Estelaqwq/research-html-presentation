{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-html-presentation/edit-registry.schema.json",
  "title": "Presentation Edit Registry",
  "oneOf": [
    { "$ref": "#/$defs/registryV1" },
    { "$ref": "#/$defs/registryV2" }
  ],
  "$defs": {
    "outputMode": { "enum": ["slide-deck", "scroll-report"] },
    "scope": { "enum": ["shared", "slide-deck", "scroll-report"] },
    "hash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "textBoxSize": {
      "type": "object",
      "properties": { "width": { "type": "number" }, "minHeight": { "type": "number" } },
      "additionalProperties": false
    },
    "resize": {
      "type": "object",
      "required": ["mode", "minWidth", "maxWidth", "minHeight", "maxMinHeight"],
      "properties": {
        "mode": { "enum": ["slide", "report"] },
        "defaultValue": { "$ref": "#/$defs/textBoxSize" },
        "minWidth": { "type": "number" },
        "maxWidth": { "type": "number" },
        "minHeight": { "type": "number" },
        "maxMinHeight": { "type": "number" },
        "snap": { "type": "number", "exclusiveMinimum": 0 },
        "protectedSelectors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "commonField": {
      "type": "object",
      "required": ["editId", "targetId", "field", "scope", "expectedValueHash"],
      "properties": {
        "editId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "expectedValueHash": { "$ref": "#/$defs/hash" },
        "basisIds": { "$ref": "#/$defs/stringArray" },
        "reviewOnChange": { "type": "boolean" },
        "resize": { "$ref": "#/$defs/resize" }
      }
    },
    "fieldV1": {
      "allOf": [
        { "$ref": "#/$defs/commonField" },
        {
          "type": "object",
          "required": ["strategy", "baseValue"],
          "properties": {
            "strategy": { "enum": ["plain-copy", "evidence-copy", "locked"] },
            "baseValue": { "type": "string" },
            "modelSearchAdequacy": { "enum": ["sufficient", "limited", "preliminary", "not-applicable"] },
            "plainLanguage": { "type": "boolean" }
          }
        }
      ]
    },
    "stableSelector": {
      "type": "string",
      "pattern": "^(?!.*:nth-child\\().*\\[(?:data-edit-id|data-content-key|data-visual-id)(?:=|\\])"
    },
    "imagePosition": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number", "minimum": 0, "maximum": 100 }, "y": { "type": "number", "minimum": 0, "maximum": 100 } },
      "additionalProperties": false
    },
    "imageBaseValue": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/avif"] },
        "byteSize": { "type": "integer", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "fit": { "enum": ["contain", "cover"] },
        "position": { "$ref": "#/$defs/imagePosition" }
      },
      "additionalProperties": false
    },
    "textFieldV2": {
      "allOf": [
        { "$ref": "#/$defs/commonField" },
        {
          "type": "object",
          "required": ["kind", "selector", "strategy", "baseValue"],
          "properties": {
            "kind": { "const": "text" },
            "selector": { "$ref": "#/$defs/stableSelector" },
            "strategy": { "enum": ["plain-copy", "evidence-copy", "locked"] },
            "baseValue": { "type": "string" },
            "plainLanguage": { "type": "boolean" },
            "modelSearchAdequacy": { "enum": ["sufficient", "limited", "preliminary", "not-applicable"] }
          }
        }
      ]
    },
    "imageFieldV2": {
      "allOf": [
        { "$ref": "#/$defs/commonField" },
        {
          "type": "object",
          "required": ["kind", "selector", "strategy", "baseValue"],
          "properties": {
            "kind": { "const": "image" },
            "selector": { "$ref": "#/$defs/stableSelector" },
            "strategy": { "enum": ["plain-image", "evidence-image", "locked"] },
            "baseValue": { "$ref": "#/$defs/imageBaseValue" },
            "allowedFits": { "type": "array", "uniqueItems": true, "items": { "enum": ["contain", "cover"] } }
          }
        }
      ]
    },
    "registryBase": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "outputMode", "baseFingerprint", "fields"],
      "properties": {
        "schemaVersion": { "enum": ["1.0", "2.0"] },
        "projectId": { "type": "string", "minLength": 1 },
        "outputMode": { "$ref": "#/$defs/outputMode" },
        "baseFingerprint": { "$ref": "#/$defs/hash" },
        "evidenceIds": { "$ref": "#/$defs/stringArray" },
        "fields": { "type": "array" }
      },
      "additionalProperties": false
    },
    "registryV1": {
      "allOf": [
        { "$ref": "#/$defs/registryBase" },
        { "properties": { "schemaVersion": { "const": "1.0" }, "fields": { "type": "array", "items": { "$ref": "#/$defs/fieldV1" } } } }
      ]
    },
    "registryV2": {
      "allOf": [
        { "$ref": "#/$defs/registryBase" },
        { "properties": { "schemaVersion": { "const": "2.0" }, "fields": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/textFieldV2" }, { "$ref": "#/$defs/imageFieldV2" }] } } } }
      ]
    }
  }
}
