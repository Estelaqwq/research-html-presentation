{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "pending",
        "ready"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rowsHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "transformIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "datasetId",
        "sourceIds",
        "sourceHash",
        "rowsHash",
        "transformIds",
        "generatedAt"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplicateExtraRecords": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplicateKeyGroups": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "incompleteKeyRecords": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "records",
        "duplicateExtraRecords",
        "duplicateKeyGroups",
        "incompleteKeyRecords"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "number",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": "string"
          },
          "records": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "valid": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "missing": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "invalid": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "unit",
          "records",
          "valid",
          "missing",
          "invalid"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "periods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "period": {
                  "type": "string",
                  "minLength": 1
                },
                "records": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "period",
                "records"
              ]
            }
          },
          "outsidePeriods": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "missingPeriods": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "groupId",
          "label",
          "periods",
          "outsidePeriods",
          "missingPeriods"
        ]
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fieldId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "checked": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "flagged": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "enum": [
              "checked",
              "insufficient"
            ]
          }
        },
        "required": [
          "fieldId",
          "label",
          "method",
          "checked",
          "flagged",
          "status"
        ]
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analysisId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "registered",
              "unregistered"
            ]
          },
          "used": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "notSelected": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sectionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "analysisId",
          "label",
          "scope",
          "reason",
          "status",
          "used",
          "notSelected"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "title",
    "summary",
    "fields",
    "coverage",
    "anomalies",
    "usage",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zuel.example/schemas/data-health.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "required": [
          "provenance"
        ],
        "properties": {
          "fields": {
            "minItems": 1
          },
          "provenance": {
            "properties": {
              "sourceIds": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
